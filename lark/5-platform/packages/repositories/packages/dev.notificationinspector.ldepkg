{
  "manifest": {
    "id": "dev.notificationinspector",
    "title": "Notification Inspector",
    "description": "Platform Diagnostics: Audits session-scoped notification state.",
    "minimumOsVersion": "1.0.0",
    "sdkVersion": "1.0.0",
    "capabilities": {},
    "runtime": {
      "loader": "lrfs",
      "entryPoint": "index.js",
      "singleton": true,
      "category": "Developer Tools",
      "startup": {
        "intent": false
      }
    },
    "install": {
      "version": "1.0.0",
      "author": "LDE Architecture Team",
      "enabled": true
    }
  },
  "files": {
    "index.js": "\nconst omni_card = (omni_components) => `\n    <div class=\"comp-card\">\n        ${omni_components}\n    </div>\n`;\nconst omni_button = (id, icon, label, variant = '', extraClass = '', disabled = false) => {\n    const variantClass = variant ? `comp-btn-${variant}` : '';\n    const disabledAttr = disabled ? 'disabled' : '';\n    return `\n        <button id=\"${id}\" class=\"comp-btn ${variantClass} ${extraClass}\" ${disabledAttr}>\n            ${icon ? `<i>${icon}</i>` : ''}${label}\n        </button>\n    `;\n};\nconst omni_listItem = (text_primary, text_secondary, text_tertiary, omni_components) => `\n    <div class=\"layout-v flex-1 flex-gap-2\">\n        <p>${text_primary}</p>\n        ${text_secondary ? `<small>${text_secondary}</small>` : ''}\n        ${text_tertiary ? `<small class=\"er\">${text_tertiary}</small>` : ''}\n        ${omni_components ? `${omni_components}` : ''}\n    </div>\n`;\nconst omni_preferenceItem = (text_primary, text_secondary, text_tertiary, actions) => `\n    <div class=\"layout-h flex-align-center flex-gap-16\">\n        <div class=\"layout-v flex-1 flex-gap-2\">\n            <p>${text_primary}</p>\n            ${text_secondary ? `<small>${text_secondary}</small>` : ''}\n            ${text_tertiary ? `<small class=\"er\">${text_tertiary}</small>` : ''}\n        </div>\n        <div>\n            ${actions || ''}\n        </div>\n    </div>\n`;\nconst omni_group = (label, omni_components, id = '', extraClass = '') => {\n    const labelHtml = label ? `<small>${label}</small>` : '';\n    const idAttr = id ? `id=\"${id}\"` : '';\n    return `\n        ${labelHtml}\n        <div ${idAttr} class=\"comp-group ${extraClass}\">\n            ${omni_components}\n        </div>\n    `;\n};\n\nexport default {\n    async run(registry) {\n        const procRecord = registry.getProcessRecord();\n        const winService = registry.get('WindowService');\n        const sessionService = registry.get('SessionService');\n        const notificationService = registry.get('NotificationService');\n\n        if (!winService || !sessionService || !notificationService) return;\n\n        const win = winService.createWindow({\n            pid: procRecord.pid,\n            title: 'Notification Inspector',\n            width: 500,\n            height: 600\n        });\n\n        const container = document.createElement('div');\n        container.style.padding = '16px';\n        container.style.overflowY = 'auto';\n        \n        const renderUI = () => {\n            const session = sessionService.getCurrentSession();\n            const notifications = notificationService.getNotifications() || [];\n\n            const statusHtml = \n                omni_preferenceItem('Session ID', session ? session.id : 'None', '', '') +\n                omni_preferenceItem('Current User', session ? session.user.username : 'Unknown', '', '') +\n                omni_preferenceItem('Notification Count', String(notifications.length), '', '');\n\n            let contentHtml = '';\n            if (notifications.length === 0) {\n                contentHtml = omni_listItem('No active notifications', '', '', '');\n            } else {\n                for (const notif of notifications) {\n                    const dismissBtn = omni_button(`btn-dismiss-${notif.id}`, '', 'Dismiss');\n                    contentHtml += omni_preferenceItem(notif.title, notif.message, '', dismissBtn);\n                }\n            }\n\n            const btnCreate = omni_button(`btn-create-${win.id}`, '', 'Create Test');\n            const btnBottom = omni_button(`btn-clear-${win.id}`, '', 'Clear All') + omni_button(`btn-refresh-${win.id}`, '', 'Refresh');\n\n            container.innerHTML = \n                omni_group('Controls', omni_card(btnCreate)) +\n                omni_group('Status', omni_card(statusHtml)) +\n                omni_group('Active Notifications', omni_card(contentHtml)) +\n                omni_group('Actions', omni_card(btnBottom));\n\n            container.querySelector(`#btn-create-${win.id}`).onclick = () => {\n                notificationService.notify({\n                    title: `Test Notification ${Math.floor(Math.random() * 1000)}`,\n                    message: 'This is a test notification generated by the inspector.',\n                    type: 'info'\n                });\n            };\n            container.querySelector(`#btn-clear-${win.id}`).onclick = () => {\n                notificationService.clearAll();\n            };\n            container.querySelector(`#btn-refresh-${win.id}`).onclick = () => renderUI();\n\n            for (const notif of notifications) {\n                const btn = container.querySelector(`#btn-dismiss-${notif.id}`);\n                if (btn) {\n                    btn.onclick = () => {\n                        notificationService.dismiss(notif.id);\n                    };\n                }\n            }\n        };\n\n        const unsubscribe = notificationService.onChange((event) => renderUI());\n        win.onClose = () => unsubscribe();\n\n        win.contentElement.appendChild(container);\n        renderUI();\n    }\n};\n"
  }
}