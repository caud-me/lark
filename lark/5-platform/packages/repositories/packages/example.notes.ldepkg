{
    "manifest":  {
                     "id":  "example.notes",
                     "title":  "Reference Notes",
                     "description":  "A canonical reference application demonstrating LDE capabilities, window lifecycle, and native UI patterns.",
                     "minimumOsVersion":  "1.0.0",
                     "sdkVersion":  "1.0.0",
                     "capabilities":  {
                                          "fileTypes":  [
                                                            ".txt",
                                                            ".md",
                                                            ".json",
                                                            ".log",
                                                            ".js"
                                                        ]
                                      },
                     "runtime":  {
                                     "loader":  "lrfs",
                                     "entryPoint":  "index.js",
                                     "singleton":  false,
                                     "category":  "Developer Tools",
                                     "startup":  {
                                                     "intent":  true,
                                                     "reason":  "Keep your notes synchronized."
                                                 },
                                     "searchableIntents":  [
                                                               {
                                                                   "title":  "New Note",
                                                                   "keywords":  [
                                                                                    "note",
                                                                                    "memo",
                                                                                    "text",
                                                                                    "write",
                                                                                    "create"
                                                                                ],
                                                                   "icon":  "ÃƒÂ°Ã…Â¸Ã¢â‚¬Å“Ã‚Â",
                                                                   "intent":  {
                                                                                  "type":  "notes.new"
                                                                              }
                                                               }
                                                           ]
                                 },
                     "install":  {
                                     "version":  "2.0.0",
                                     "author":  "LDE Architecture Team",
                                     "enabled":  true
                                 }
                 },
    "files":  {
                  "index.js":  "const omni_button = (id, icon, label, variant = \u0027\u0027, extraClass = \u0027\u0027, disabled = false) =\u003e {\n    const variantClass = variant ? `comp-btn-${variant}` : \u0027\u0027;\n    const disabledAttr = disabled ? \u0027disabled\u0027 : \u0027\u0027;\n    return `\u003cbutton id=\"${id}\" class=\"comp-btn ${variantClass} ${extraClass}\" ${disabledAttr}\u003e\u003ci\u003e${icon}\u003c/i\u003e${label}\u003c/button\u003e`;\n};\n\nexport default {\n    async run(registry) {\n        const launchContext = registry.getLaunchContext();\n        const procRecord = registry.getProcessRecord();\n        const pid = procRecord.pid;\n        const capabilityService = registry.get(\u0027CapabilityService\u0027);\n        const dialogCapability = capabilityService ? capabilityService.get(\u0027dialogs\u0027, pid) : null;\n        \n        const winService = registry.get(\u0027WindowService\u0027);\n        const fileService = registry.get(\u0027FileService\u0027);\n        \n        let currentFilePath = null;\n        let isDirty = false;\n        let originalText = \u0027\u0027;\n\n        const win = winService.createWindow({ \n            pid,\n            title: \u0027Notes\u0027,\n            width: 600,\n            height: 450,\n            minWidth: 400,\n            minHeight: 300\n        });\n\n        // Main application layouts matching Omni frame layout structures\n        const container = document.createElement(\u0027div\u0027);\n        container.className = \u0027omni-layout-row\u0027;\n        container.style.height = \u0027100%\u0027;\n        container.style.flexDirection = \u0027column\u0027;\n\n        // Standard clean action bar container \n        const toolbar = document.createElement(\u0027div\u0027);\n        toolbar.className = \u0027layout-h flex-gap-8 flex-align-center\u0027;\n        toolbar.style.padding = \u00278px 12px\u0027;\n        toolbar.style.borderBottom = \u00271px solid #1c1c1c\u0027;\n        toolbar.style.background = \u0027#101010\u0027;\n\n        const contentArea = document.createElement(\u0027div\u0027);\n        contentArea.className = \u0027flex-1\u0027;\n        contentArea.style.position = \u0027relative\u0027;\n\n        const textarea = document.createElement(\u0027textarea\u0027);\n        textarea.id = `notes-textarea-${win.id}`;\n        textarea.placeholder = \u0027Start typing...\u0027;\n        textarea.style.width = \u0027100%\u0027;\n        textarea.style.height = \u0027100%\u0027;\n        textarea.style.border = \u0027none\u0027;\n        textarea.style.outline = \u0027none\u0027;\n        textarea.style.resize = \u0027none\u0027;\n        textarea.style.padding = \u002716px\u0027;\n        textarea.style.boxSizing = \u0027border-box\u0027;\n        textarea.style.background = \u0027transparent\u0027;\n        textarea.style.color = \u0027var(--lde-text-primary, #ffffff)\u0027;\n        textarea.style.fontFamily = \u0027Consolas, \"Courier New\", monospace\u0027;\n        textarea.style.fontSize = \u002714px\u0027;\n        textarea.style.lineHeight = \u00271.6\u0027;\n\n        contentArea.appendChild(textarea);\n        container.appendChild(toolbar);\n        container.appendChild(contentArea);\n        win.contentElement.appendChild(container);\n\n        const updateToolbar = () =\u003e {\n            // Render icon-only actions with clean typography rules\n            const btnNewHtml = omni_button(`btn-new-${win.id}`, \u0027\u0026#xE109;\u0027, \u0027New\u0027, \u0027\u0027, \u0027small\u0027);\n            const btnOpenHtml = omni_button(`btn-open-${win.id}`, \u0027\u0026#xE188;\u0027, \u0027Open\u0027, \u0027\u0027, \u0027small\u0027);\n            const btnSaveHtml = omni_button(`btn-save-${win.id}`, \u0027\u0026#xE105;\u0027, \u0027Save\u0027, \u0027\u0027, \u0027small\u0027);\n            const btnSaveAsHtml = omni_button(`btn-save-as-${win.id}`, \u0027\u0026#xE17C;\u0027, \u0027Save As...\u0027, \u0027\u0027, \u0027small\u0027);\n\n            toolbar.innerHTML = btnNewHtml + btnOpenHtml + btnSaveHtml + btnSaveAsHtml;\n\n            // Assign click actions to layout triggers\n            toolbar.querySelector(`#btn-new-${win.id}`).onclick = handleNew;\n            toolbar.querySelector(`#btn-open-${win.id}`).onclick = handleOpen;\n            toolbar.querySelector(`#btn-save-${win.id}`).onclick = handleSave;\n            toolbar.querySelector(`#btn-save-as-${win.id}`).onclick = handleSaveAs;\n        };\n\n        const updateTitle = () =\u003e {\n            const fileName = currentFilePath ? currentFilePath.split(\u0027/\u0027).pop() : \u0027Untitled\u0027;\n            const dirtyMarker = isDirty ? \u0027 *\u0027 : \u0027\u0027;\n            winService.setWindowTitle(win.id, `Notes - ${fileName}${dirtyMarker}`);\n        };\n\n        const checkDirty = async () =\u003e {\n            if (!isDirty) return true;\n            if (dialogCapability) {\n                return await dialogCapability.confirm(\u0027You have unsaved changes. Discard them?\u0027, \u0027Unsaved Changes\u0027);\n            }\n            return confirm(\u0027You have unsaved changes. Discard them?\u0027);\n        };\n\n        textarea.addEventListener(\u0027input\u0027, () =\u003e {\n            if (textarea.value !== originalText \u0026\u0026 !isDirty) {\n                isDirty = true;\n                updateTitle();\n            }\n            if (textarea.value === originalText \u0026\u0026 isDirty) {\n                isDirty = false;\n                updateTitle();\n            }\n        });\n\n        const handleNew = async () =\u003e {\n            if (!(await checkDirty())) return;\n            currentFilePath = null;\n            originalText = \u0027\u0027;\n            textarea.value = \u0027\u0027;\n            isDirty = false;\n            updateTitle();\n            textarea.focus();\n        };\n\n        const handleOpen = async () =\u003e {\n            if (!(await checkDirty())) return;\n            if (!dialogCapability) return;\n            \n            const result = await dialogCapability.openFile({\n                pid,\n                title: \u0027Open Text File\u0027,\n                extensions: [\u0027txt\u0027, \u0027md\u0027, \u0027json\u0027, \u0027log\u0027, \u0027js\u0027]\n            });\n\n            if (result \u0026\u0026 result.path) {\n                try {\n                    const content = await fileService.readFile(result.path, { pid });\n                    currentFilePath = result.path;\n                    originalText = content;\n                    textarea.value = content;\n                    isDirty = false;\n                    updateTitle();\n                } catch (err) {\n                    await dialogCapability.alert(`Failed to open file: ${err.message}`, \u0027Error\u0027);\n                }\n            }\n        };\n\n        const handleSave = async () =\u003e {\n            if (!currentFilePath) {\n                handleSaveAs();\n                return;\n            }\n            try {\n                const text = textarea.value;\n                await fileService.writeFile(currentFilePath, text, { pid });\n                originalText = text;\n                isDirty = false;\n                updateTitle();\n            } catch (err) {\n                if (dialogCapability) {\n                    await dialogCapability.alert(`Failed to save file: ${err.message}`, \u0027Error\u0027);\n                }\n            }\n        };\n\n        const handleSaveAs = async () =\u003e {\n            if (!dialogCapability) return;\n\n            const result = await dialogCapability.saveFile({\n                pid,\n                title: \u0027Save As...\u0027,\n                defaultName: currentFilePath ? currentFilePath.split(\u0027/\u0027).pop() : \u0027Untitled.txt\u0027,\n                extensions: [\u0027txt\u0027, \u0027md\u0027, \u0027json\u0027, \u0027log\u0027, \u0027js\u0027]\n            });\n\n            if (result \u0026\u0026 result.path) {\n                try {\n                    const text = textarea.value;\n                    await fileService.writeFile(result.path, text, { pid });\n                    currentFilePath = result.path;\n                    originalText = text;\n                    isDirty = false;\n                    updateTitle();\n                } catch (err) {\n                    await dialogCapability.alert(`Failed to save file: ${err.message}`, \u0027Error\u0027);\n                }\n            }\n        };\n\n        // Process incoming initialization path parameters securely\n        const loadInitialFile = async (filePath) =\u003e {\n            if (filePath) {\n                try {\n                    const content = await fileService.readFile(filePath, { pid });\n                    currentFilePath = filePath;\n                    originalText = content;\n                    textarea.value = content;\n                    isDirty = false;\n                    updateTitle();\n                } catch (err) {\n                    console.error(\u0027Notes: Failed to load file from args\u0027, err);\n                    if (dialogCapability) {\n                        await dialogCapability.alert(`Failed to open file: ${err.message}`, \u0027Error\u0027);\n                    }\n                }\n            }\n        };\n\n        const executeIntent = async (intent) =\u003e {\n            if (intent \u0026\u0026 (intent.type === \u0027textedit.open\u0027 || intent.type === \u0027notes.open\u0027 || intent.action === \u0027open-file\u0027) \u0026\u0026 (intent.payload?.path || intent.path)) {\n                await loadInitialFile(intent.payload?.path || intent.path);\n            } else if (intent \u0026\u0026 intent.type === \u0027notes.new\u0027) {\n                await handleNew();\n                if (intent.payload \u0026\u0026 intent.payload.content) {\n                    textarea.value = intent.payload.content;\n                    isDirty = true;\n                    updateTitle();\n                }\n            }\n        };\n        const processService = registry.get(\u0027ProcessService\u0027);\n        if (processService) {\n            processService.registerInstance({ handleIntent: executeIntent });\n        }\n\n        if (launchContext \u0026\u0026 launchContext.intent) {\n            await executeIntent(launchContext.intent);\n        } else if (launchContext \u0026\u0026 launchContext.args \u0026\u0026 launchContext.args.length \u003e 0) {\n            await executeIntent({ action: \u0027open-file\u0027, path: launchContext.args[0] });\n        }\n\n        // Setup application stack runtime configurations\n        updateToolbar();\n        updateTitle();\n        setTimeout(() =\u003e textarea.focus(), 100);\n    },\n    async onIntent(registry, intent) {\n        const processService = registry.get(\u0027ProcessService\u0027);\n        if (!processService) return;\n        const appInstance = processService.getInstance();\n        if (appInstance \u0026\u0026 typeof appInstance.handleIntent === \u0027function\u0027) {\n            await appInstance.handleIntent(intent);\n        }\n    }\n};"
              }
}